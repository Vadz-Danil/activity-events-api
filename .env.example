# Copy to .env and set JWT_SECRET. Every other value below is the default the
# application already uses, so an untouched copy runs locally as is.
#
# Comments stay on their own lines on purpose: the Makefile does `include .env`,
# and make keeps everything before an inline `#` — trailing spaces included.

# ---- Application -------------------------------------------------------------
APP_ENV=development
# api | worker | all
APP_MODE=all
HTTP_PORT=8080
# Some platforms inject the port they expect the process to bind. If PORT is set
# it wins over HTTP_PORT; leave it empty everywhere you control the port yourself.
PORT=
# host port docker compose publishes the api on
API_PORT=8080
SHUTDOWN_TIMEOUT=15s
# Read and write timeouts of the http server. The stream handler lifts the write
# deadline for its own connection, so raising this is not needed for SSE.
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
# Tag baked into the image and reported by /healthz. CI passes the commit sha.
VERSION=dev
FRONTEND_URL=http://localhost:5173
MAX_BODY_BYTES=65536
# comma separated, empty means trust none
TRUSTED_PROXIES=

# ---- Logging -----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json everywhere the logs are shipped to Loki; console if you read them in a terminal
LOG_FORMAT=json

# ---- PostgreSQL container ----------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=activity
POSTGRES_PORT=5432

# ---- Database connection -----------------------------------------------------
# Used when the application runs on the host. Inside docker compose the api and
# worker get their own url pointing at the postgres service.
DATABASE_URL=postgres://app:app@localhost:5432/activity?sslmode=disable
DB_MAX_CONNS=10
# set 0 against a database that scales to zero
DB_MIN_CONNS=2
MIGRATIONS_DIR=migrations
# How hard to try on boot before giving up. Matters when the database starts
# alongside the application, or wakes from suspend.
DB_CONNECT_RETRIES=10
DB_CONNECT_BACKOFF=1s
# Repository integration tests run against this; they fall back to DATABASE_URL.
TEST_DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Aggregation -------------------------------------------------------------
# window size, must divide 24h evenly
AGGREGATION_BUCKET=4h
# how often the worker looks for closed windows
AGGREGATION_TICK=5m
# windows one pass may catch up on
AGGREGATION_BACKFILL=12

# ---- Auth --------------------------------------------------------------------
# required, no default: openssl rand -base64 48
JWT_SECRET=
JWT_SECRET_MIN_LEN=32
JWT_ISSUER=activity-events-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12

# ---- Google sign-in (optional) -----------------------------------------------
# Leave empty to disable: /auth/methods then reports google:false and the SPA
# hides the button instead of offering one that can only fail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# Google's own endpoints. Overridable so tests can point at a local stub;
# there is no reason to change them in a real deployment.
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ---- Demo data (make seed) ---------------------------------------------------
# Two accounts are created on purpose: the admin one to demonstrate the account
# picker and ?user_id=, the plain one to show what a regular user is limited to.
SEED_EMAIL=demo@example.com
SEED_PASSWORD=demo-password-123
# user | admin
SEED_ROLE=admin
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=viewer-password-123
# How much history to generate. The viewer gets a third of SEED_EVENTS.
SEED_DAYS=7
SEED_EVENTS=600

# ---- Frontend ----------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# ---- Monitoring --------------------------------------------------------------
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
